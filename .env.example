# Copy to .env and fill in. Never commit the real .env.

# --- Core ---
# The API's public URL (scheme + host). The MCP/OAuth endpoints advertise it to
# clients like Claude, so behind a reverse proxy use the public HTTPS address,
# e.g. https://overload-api.example.com — not a LAN IP.
ORIGIN=http://localhost:3000
PORT=3000
# Generate: openssl rand -base64 48
SESSION_SECRET=
TZ=America/Chicago
LOG_LEVEL=info

# --- Database ---
DATABASE_URL=postgres://overload:change-me@overload-db:5432/overload
DB_PASSWORD=change-me
# Host port the app is published on (reach it by LAN IP:port at home):
OVERLOAD_PORT=3000

# --- Admin bootstrap (used once, on first boot, if no admin exists) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-long-random

# --- App behavior ---
DEFAULT_UNIT=lb
INVITE_DEFAULT_EXPIRY_DAYS=14
REST_TIMER_DEFAULT_SEC=120
WEEK_START=monday

# --- Decoupled UI / cross-origin client ---
# Comma-separated UI origins allowed to call the API (e.g. a GitHub Pages site).
# Leave empty for same-origin only.
CORS_ALLOWED_ORIGINS=
# Accept bearer-token auth in addition to cookies (needed for a cross-origin UI).
AUTH_TOKENS_ENABLED=true

# --- In-app feedback → GitHub issues (optional) ---
# Feedback is always saved; with these set it is also filed as a GitHub issue
# and users can see the issue's status and replies. Use a fine-grained token
# scoped to this one repo with "Issues: read & write".
# GITHUB_FEEDBACK_REPO=owner/repo
# GITHUB_FEEDBACK_TOKEN=
# GITHUB_FEEDBACK_LABELS=feedback

# --- Optional AI coach (off by default) ---
AI_ENABLED=false
# AI_PROVIDER=anthropic
# AI_BASE_URL=
# AI_API_KEY=
# AI_MODEL=
